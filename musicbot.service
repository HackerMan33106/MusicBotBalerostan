[Unit]
Description=Discord Music Bot
After=network.target

[Service]
Type=simple
User=username
WorkingDirectory=/home/username/app/MusicBot
ExecStart=/home/username/app/MusicBot/.venv/bin/python main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

