# Токен Discord бота (получить на https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Spotify API (получить на https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Дополнительные настройки бота
COMMAND_PREFIX=!
DEFAULT_LANGUAGE=ru
MAX_DURATION=600
EMBED_COLOR=0xFFA200
INACTIVITY_TIMEOUT=10
EMPTY_QUEUE_TIMEOUT=20

